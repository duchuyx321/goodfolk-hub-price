// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model CatalogVersion {
  id          String         @id @default(cuid())
  version     String
  source      String
  entryCount  Int
  payload     String         @default("{}")
  createdAt   DateTime       @default(now())
  entries     CatalogEntry[]
}

model CatalogEntry {
  id          String         @id @default(cuid())
  sku         String         @unique
  style       String
  color       String
  size        String
  price       Float
  currency    String         @default("USD")
  versionId   String
  version     CatalogVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@index([versionId])
}

// A reusable set of product options (name + values) that can be applied to
// multiple products at once. Each option value may carry a price delta (added
// to the product's base price) and a skuKey used when building variant SKUs.
// options is a JSON array of:
//   [{ name: string, values: [{ value: string, skuKey?: string, priceDelta?: number }] }]
model VariantTemplate {
  id         String   @id @default(cuid())
  name       String
  skuPattern String   @default("{sku}-{option1}-{option2}")
  options    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
